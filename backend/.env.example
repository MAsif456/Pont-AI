# --- Pont AI backend configuration ---
# Copy this file to ".env" and fill in real values. Never commit ".env".

# Selects how language-model and embedding calls are made.
#   mock = deterministic offline fixtures, no API key needed (default, used by tests)
#   live = real Google Gemini calls, requires GEMINI_API_KEY below
PONT_LLM_MODE=mock

# Google AI Studio API key (only needed when PONT_LLM_MODE=live).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model identifiers (override only if you need to).
PONT_GENERATION_MODEL=gemini-2.5-flash
PONT_EMBEDDING_MODEL=gemini-embedding-001

# Cross-origin origins permitted to call the API (comma-separated).
PONT_CORS_ORIGINS=http://localhost:3000
